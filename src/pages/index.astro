---
import { existsSync } from 'node:fs';
import Layout from '../layouts/Layout.astro';

const profile = {
  name: 'DJIBODE Prince Ascel Jacne',
  short: 'Prince Ascel',
  role: 'Développeur Full-Stack',
  location: 'Mulhouse',
  email: 'djibodeprinceascel@gmail.com',
  github: 'https://github.com/PrinceAscelJacne',
  cv: '/CV_Prince_Ascel_DJIBODE.pdf',
  portrait: '/images/profile-portrait2.png',
};

const portraitFile = new URL(`../../public${profile.portrait}`, import.meta.url);
const hasPortrait = existsSync(portraitFile);
const contactApiBase = String(import.meta.env.PUBLIC_CONTACT_API_BASE ?? '').trim();
const contactApiUrl = contactApiBase
  ? `${contactApiBase.replace(/\/$/, '')}/api/contact`
  : '/api/contact';

const services = [
  { title: 'Sites vitrines et interfaces web', text: 'Création de pages modernes et lisibles avec HTML, CSS, JavaScript et Bootstrap.' },
  { title: 'Applications web Laravel / PHP', text: 'Développement de modules métier et de fonctionnalités web avec une structure claire.' },
  { title: 'Intégration responsive', text: 'Interfaces adaptées mobile, tablette et desktop avec attention aux détails visuels.' },
  { title: 'Modélisation et base de données', text: 'Conception de schémas avec UML/Merise et intégration MySQL sur les projets web.' },
  { title: 'Maintenance et amélioration', text: 'Correction de bugs, optimisation de pages existantes et stabilisation du code.' },
  { title: 'Collaboration projet', text: 'Participation à l’analyse des besoins, aux tests et au suivi de mise en production.' },
];

const skills = [
  { group: 'Web et Frameworks', items: ['HTML', 'CSS', 'JavaScript', 'PHP', 'Laravel', 'Bootstrap'] },
  { group: 'Langages et Mobile', items: ['Flutter', 'C++', 'Python', 'Java'] },
  { group: 'Analyse et Bases de donnees', items: ['MySQL', 'UML', 'Merise'] },
  { group: 'Outils', items: ['VS Code', 'Eclipse', 'Code::Blocks', 'Laragon', 'XAMPP'] },
];

const parcours = [
  {
    year: '2021',
    title: 'Baccalauréat Série D - Sainte Jeanne d’Arc',
    text: 'Validation des bases scientifiques et analytiques.',
  },
  {
    year: '2023',
    title: 'Stage Analyste programmeur - Super U Erevan (Bénin)',
    text: 'Participation au développement web, intégration front-end et tests applicatifs.',
  },
  {
    year: '2024',
    title: 'Stage Développeur web - ASTUS CITEE (Cotonou, Bénin)',
    text: 'Application de gestion documentaire et site vitrine pour l’entreprise.',
  },
  {
    year: '2023-2024',
    title: 'Licence Pro Analyse Informatique et Programmation - ENEAM',
    text: 'Renforcement en dev web, méthodes et architecture logicielle.',
  },
  {
    year: '2025-2026',
    title: 'Licence 3 MIAGE - FST UHA (Mulhouse)',
    text: 'Formation actuelle orientée systèmes d’information, développement et besoins métier.',
  },
];

const projects = [
  {
    title: 'Projet Graphe et Algorithmes',
    text: 'Application Java de création, visualisation et analyse de graphes avec architecture MVC.',
    stack: 'Java - Architecture MVC (Swing, JavaSE-21)',
    points: [
      'Création et visualisation interactive de graphes (orientés/non orientés, pondérés) via interface Swing.',
      'Implémentation d’algorithmes: Dijkstra, Dantzig, Tarjan, Kruskal, Prüfer et tests de connexité.',
      'Module d’ordonnancement: chemin critique, dates au plus tôt/tard et diagramme de Gantt.',
      'Simulation du réseau RER parisien (24 stations, 4 lignes) avec calcul du trajet optimal.',
    ],
    link: 'https://github.com/PrinceAscelJacne/MonProjetDeGrapheEtAlgo',
    image: '/images/projet-graphe-algo.png',
  },
  {
    title: 'Astus Citée - Site vitrine',
    text: 'Conception et intégration d’un site vitrine pour améliorer la visibilité de l’entreprise.',
    stack: 'HTML, CSS, JavaScript, PHP',
    points: [
      'Conception et intégration d’un site vitrine pour améliorer la visibilité de l’entreprise.',
    ],
    link: 'https://github.com/PrinceAscelJacne/Astus-Cit-e',
    image: '/images/projet-astus-vitrine.jpeg',
  },
  {
    title: 'GestiLoc - Gestion locative en ligne',
    text: 'Application web de gestion locative dédiée aux propriétaires béninois.',
    stack: 'Laravel, MySQL, JavaScript - Déployée sur Vercel',
    points: [
      'Gestion des biens, locataires, contrats et paiements (CRUD complet avec authentification).',
      'Interface moderne et responsive déployée en production sur Vercel.',
      'Lien démo: gestiloc-rho.vercel.app',
    ],
    link: 'https://gestiloc-rho.vercel.app',
    image: '/images/projet-gestiloc.png',
  },
  {
    title: 'Gestionnaire de questionnaires',
    text: 'Application C++ pour la gestion de questionnaires avec plusieurs modes d’évaluation.',
    stack: 'C++',
    points: [
      'Gestion de types de questions: texte libre, numérique et QCM.',
      'Sauvegarde et lecture depuis fichiers texte.',
      'Trois modes d’évaluation.',
    ],
    link: 'https://github.com/PrinceAscelJacne/Questionnaire-Cpp',
    image: '/images/questionnaire-illustration.svg',
  },
  {
    title: 'Crypto - Chiffrement de messages',
    text: 'Projet de chiffrement polyalphabétique implémenté en deux langages.',
    stack: 'Python, C++',
    points: [
      'Implémentation d’un algorithme de chiffrement polyalphabétique.',
      'Développement en deux langages pour comparer les approches.',
      'Interface de test pour saisir le message et vérifier le résultat chiffré.',
    ],
    link: 'https://github.com/PrinceAscelJacne/Crypto',
    image: '/images/crypto-illustration.svg',
  },
];
---

<Layout title={`${profile.name} | Portfolio`} description="Portfolio full-stack de DJIBODE Prince Ascel Jacne.">
  <main class="site">
    <div class="texture" aria-hidden="true"></div>

    <header class="topbar shell">
      <a class="brand" href="#hero">
        <span class="badge-logo">PA</span>
        <span>{profile.short}</span>
      </a>

      <input id="menu-toggle" class="menu-toggle" type="checkbox" />
      <label for="menu-toggle" class="burger" aria-label="Ouvrir le menu">
        <span></span><span></span><span></span>
      </label>

      <nav class="nav desktop-nav" aria-label="Navigation principale">
        <a href="#hero">Accueil</a>
        <a href="#about">À propos</a>
        <a href="#services">Services</a>
        <a href="#skills">Compétences</a>
        <a href="#parcours">Parcours</a>
        <a href="#projects">Projets</a>
      </nav>

      <a class="btn btn-outline nav-contact" href="#contact">Contact</a>

      <nav class="nav mobile-nav" aria-label="Navigation mobile">
        <a href="#hero">Accueil</a>
        <a href="#about">À propos</a>
        <a href="#services">Services</a>
        <a href="#skills">Compétences</a>
        <a href="#parcours">Parcours</a>
        <a href="#projects">Projets</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <section id="hero" class="hero shell reveal">
      <div class="hero-intro">
        <p class="hero-eyebrow">HELLO, MON NOM C’EST</p>
        <h1>
          <span>{profile.name}</span>
          <strong>{profile.role}</strong>
        </h1>
        <p>
          Je conçois des applications web utiles, lisibles et maintenables, avec une approche orientée besoin métier
          et un travail rigoureux sur l’intégration front-end et back-end.
        </p>
      </div>

      <div class="hero-stage">
        <span class="orbit-chip c1">HTML/CSS/JS</span>
        <span class="orbit-chip c2">PHP / Laravel</span>
        <span class="orbit-chip c3">MySQL</span>
        <span class="orbit-chip c4">UML / Merise</span>
        <span class="orbit-chip c5">Flutter</span>
        <span class="orbit-chip c6">C++ / Python</span>

        <div class="hero-photo-wrap">
          <div class="halo"></div>
          {
            hasPortrait ? (
              <img class="hero-photo" src={profile.portrait} alt="Portrait de Prince Ascel" loading="eager" />
            ) : (
              <div class="fallback">Ajoute public/images/profile-portrait2.png</div>
            )
          }
        </div>

        <div class="hero-cta">
          <a class="btn btn-solid" href="#services">Mes services</a>
          <a class="btn btn-outline" href="#projects">Mes projets</a>
          <a class="btn btn-outline" href={profile.cv} target="_blank" rel="noopener">Télécharger CV</a>
        </div>
        <div class="hero-tags">
          <span>Laravel</span><span>PHP</span><span>JavaScript</span><span>MySQL</span><span>UML</span><span>Python</span>
        </div>
      </div>
    </section>

    <section id="about" class="block shell reveal">
      <div class="block-head">
        <h2>À propos de moi</h2>
      </div>
      <div class="about-copy">
        <p>
          Je suis DJIBODE Prince Ascel Jacne, développeur Full Stack basé en France.
          Actuellement en Licence 3 MIAGE à FST UHA, je conçois des applications web utiles, lisibles et
          maintenables, avec une approche orientée besoin métier.
        </p>
        <p>
          Mes compétences couvrent principalement le développement web (HTML, CSS, JavaScript, PHP/Laravel),
          la modélisation (UML, Merise), les bases de données MySQL, ainsi que des langages comme Java,
          Python, C++ et Flutter. Mon objectif est de livrer des applications claires, fonctionnelles et
          maintenables.
        </p>
        <p>
          Actuellement à la recherche d’un stage de 3 mois pour valider mon année de L3, je suis par ailleurs
          déjà admis en Master 1 MIAGE en alternance à l’Université d’Orléans pour la rentrée de septembre 2026.
        </p>
      </div>
    </section>

    <section id="services" class="block shell reveal">
      <div class="block-head">
        <h2> Ce que je peux construire</h2>
        <p>Des prestations alignées sur mes compétences réelles et mes expériences de terrain.</p>
      </div>
      <div class="service-grid">
        {services.map((service, index) => (
          <article class="card scroll-reveal" style={`--delay:${index * 70}ms`}>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="skills" class="block shell reveal">
      <div class="block-head">
        <h2>Compétences</h2>
        <p>Stack principale: HTML, CSS, JavaScript, PHP/Laravel, MySQL, UML/Merise, Python, C++, Flutter.</p>
      </div>
      <div class="skill-grid">
        {skills.map((skill, index) => (
          <article class="skill-card scroll-reveal" style={`--delay:${index * 60}ms`}>
            <h3>{skill.group}</h3>
            <div class="chip-list">
              {skill.items.map((item) => <span>{item}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="parcours" class="block shell reveal">
      <div class="block-head">
        <h2>Parcours</h2>
        <p>
          Mon parcours combine une base académique solide et des expériences pratiques en entreprise,
          avec une progression continue vers le développement web full-stack.
        </p>
      </div>
      <div class="tree">
        <div class="tree-line" aria-hidden="true"></div>
        <div class="tree-items">
          {parcours.map((step, index) => (
            <article class={`tree-item ${index % 2 === 0 ? 'left' : 'right'} scroll-reveal`} style={`--delay:${index * 80}ms`}>
              <span class="year">{step.year}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="projects" class="block shell reveal">
      <div class="block-head inline">
        <h2>Projets</h2>
        <a class="btn btn-outline" href={profile.github} target="_blank" rel="noopener">Voir GitHub</a>
      </div>
      <div class="projects-carousel">
        <button class="carousel-btn prev" type="button" aria-label="Projet précédent">‹</button>
        <div class="project-viewport" id="project-viewport">
          <div class="project-track">
            {projects.map((project, index) => (
              <article class="project-card scroll-reveal" style={`--delay:${index * 80}ms`}>
                {project.image && <img class="project-thumb" src={project.image} alt={project.title} loading="lazy" />}
                <h3>{project.title}</h3>
                <p>{project.text}</p>
                {project.points && (
                  <ul class="project-points">
                    {project.points.map((point) => <li>{point}</li>)}
                  </ul>
                )}
                <footer>
                  <span>{project.stack}</span>
                  <div class="project-links">
                    <a href={project.link} target="_blank" rel="noopener">Voir</a>
                    {project.repo && <a href={project.repo} target="_blank" rel="noopener">GitHub</a>}
                  </div>
                </footer>
              </article>
            ))}
          </div>
        </div>
        <button class="carousel-btn next" type="button" aria-label="Projet suivant">›</button>
      </div>
    </section>

    <section id="contact" class="block shell reveal">
      <div class="block-head">
        <h2>Contact</h2>
        <p>Envoie ton besoin, je te réponds avec un plan d’action clair.</p>
      </div>
      <div class="contact-grid">
        <form class="contact-form" id="contact-form" data-endpoint={contactApiUrl}>
          <div class="row2">
            <label>Nom *<input type="text" name="nom" required /></label>
            <label>Email *<input type="email" name="email" required /></label>
          </div>
          <label>Sujet *<input type="text" name="sujet" required /></label>
          <label>Message *<textarea name="message" rows="6" required></textarea></label>
          <button class="btn btn-solid" type="submit">Envoyer</button>
          <p id="contact-feedback" class="contact-feedback" role="status" aria-live="polite"></p>
        </form>

        <aside class="contact-side">
          <article>
            <h3>Email</h3>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </article>
          <article>
            <h3>GitHub</h3>
            <a href={profile.github} target="_blank" rel="noopener">@PrinceAscelJacne</a>
          </article>
          <article>
            <h3>CV</h3>
            <a href={profile.cv} target="_blank" rel="noopener">Voir le CV</a>
          </article>
        </aside>
      </div>
    </section>

    <footer class="footer shell">
      <p>Copyright 2026 {profile.name}</p>
      <div>
        <a href={profile.github} target="_blank" rel="noopener">GitHub</a>
        <a href={`mailto:${profile.email}`}>Email</a>
      </div>
    </footer>

    <script>
      if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
        document.body.classList.add('motion-enabled');
        const targets = document.querySelectorAll('.reveal, .scroll-reveal');
        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('visible');
            obs.unobserve(entry.target);
          });
        }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
        targets.forEach((el) => observer.observe(el));
      }

      const viewport = document.getElementById('project-viewport');
      const prevBtn = document.querySelector('.carousel-btn.prev');
      const nextBtn = document.querySelector('.carousel-btn.next');
      if (viewport && prevBtn && nextBtn) {
        const getStep = () => {
          const firstCard = viewport.querySelector('.project-card');
          const track = viewport.querySelector('.project-track');
          if (!firstCard || !track) return viewport.clientWidth;
          const styles = window.getComputedStyle(track);
          const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
          return firstCard.getBoundingClientRect().width + gap;
        };

        const goToIndex = (index) => {
          const step = getStep();
          const maxIndex = Math.max(0, Math.round((viewport.scrollWidth - viewport.clientWidth) / step));
          const clamped = Math.max(0, Math.min(index, maxIndex));
          viewport.scrollTo({ left: clamped * step, behavior: 'smooth' });
        };

        const getCurrentIndex = () => {
          const step = getStep();
          return step > 0 ? Math.round(viewport.scrollLeft / step) : 0;
        };

        const syncButtons = () => {
          const maxLeft = viewport.scrollWidth - viewport.clientWidth - 2;
          prevBtn.disabled = viewport.scrollLeft <= 2;
          nextBtn.disabled = viewport.scrollLeft >= maxLeft;
        };

        prevBtn.addEventListener('click', () => {
          goToIndex(getCurrentIndex() - 1);
        });
        nextBtn.addEventListener('click', () => {
          goToIndex(getCurrentIndex() + 1);
        });

        viewport.addEventListener('scroll', syncButtons, { passive: true });
        window.addEventListener('resize', () => {
          goToIndex(getCurrentIndex());
          syncButtons();
        });
        syncButtons();
      }

      const form = document.getElementById('contact-form');
      const feedback = document.getElementById('contact-feedback');
      if (form && feedback) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const submitButton = form.querySelector('button[type="submit"]');
          const endpoint = form.dataset.endpoint;
          const formData = new FormData(form);
          const payload = {
            nom: String(formData.get('nom') || '').trim(),
            email: String(formData.get('email') || '').trim(),
            sujet: String(formData.get('sujet') || '').trim(),
            message: String(formData.get('message') || '').trim(),
          };

          if (!endpoint) {
            feedback.textContent = 'Erreur de configuration du formulaire.';
            feedback.dataset.state = 'error';
            return;
          }

          submitButton?.setAttribute('disabled', 'true');
          feedback.textContent = 'Envoi en cours...';
          feedback.dataset.state = 'loading';

          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            const result = await response.json().catch(() => ({}));
            if (!response.ok) {
              throw new Error(result?.error || 'Erreur serveur');
            }
            feedback.textContent = 'Message envoyé. Vérification envoyée sur votre email.';
            feedback.dataset.state = 'success';
            form.reset();
          } catch (error) {
            feedback.textContent = 'Impossible d’envoyer le message. Réessayez.';
            feedback.dataset.state = 'error';
          } finally {
            submitButton?.removeAttribute('disabled');
          }
        });
      }
    </script>
  </main>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

  :root {
    --bg: #f3eee5;
    --bg-2: #ece4d8;
    --panel: #fbf7f0;
    --panel-2: #f0e7da;
    --line: rgba(131, 93, 52, 0.26);
    --text: #2a2016;
    --muted: #6f5f50;
    --accent: #805531;
    --accent-2: #ab7648;
    --max: 1280px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: 'Manrope', sans-serif;
    color: var(--text);
    background: linear-gradient(180deg, var(--bg), var(--bg-2));
  }

  .site { position: relative; overflow-x: clip; padding-bottom: 2rem; }

  .texture {
    position: fixed;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgba(79, 50, 24, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(79, 50, 24, 0.05) 1px, transparent 1px);
    background-size: 52px 52px;
    pointer-events: none;
  }

  .shell { width: min(var(--max), calc(100% - 2rem)); margin: 0 auto; }

  .topbar {
    margin-top: 1rem;
    position: sticky;
    top: 0.8rem;
    z-index: 40;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.6rem 0.8rem;
    background: rgba(250, 245, 236, 0.9);
    backdrop-filter: blur(8px);
  }

  .brand {
    text-decoration: none;
    color: var(--text);
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .badge-logo {
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    color: var(--accent);
  }

  .nav { display: flex; align-items: center; gap: 1rem; }
  .desktop-nav { justify-self: center; }

  .nav a {
    text-decoration: none;
    color: #553f2e;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .btn {
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid transparent;
    padding: 0.7rem 1.1rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.18s ease, filter 0.18s ease;
  }

  .btn:hover { transform: translateY(-2px); filter: brightness(1.03); }

  .btn-solid {
    color: #fff9f0;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
  }

  .btn-outline {
    color: #5e452f;
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.55);
  }

  .nav-contact { justify-self: end; }

  .menu-toggle, .burger, .mobile-nav { display: none; }

  .hero {
    padding: 1.1rem 0 1rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }

  .hero-intro {
    max-width: 74ch;
    margin: 0 auto;
    text-align: center;
  }

  .hero-eyebrow {
    margin: 0;
    width: fit-content;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.48rem 0.9rem;
    font-size: 0.78rem;
    font-weight: 800;
    color: #6b513c;
    margin-inline: auto;
  }

  h1 { margin: 0.5rem 0 0; line-height: 1.06; }

  h1 span {
    display: block;
    font-size: clamp(1.3rem, 3vw, 2.2rem);
  }

  h1 strong {
    display: block;
    margin-top: 0.2rem;
    font-size: clamp(1.35rem, 3.3vw, 2.35rem);
    color: var(--accent);
  }

  .hero-intro p {
    margin: 0.55rem 0 0;
    color: var(--muted);
    max-width: 62ch;
    line-height: 1.55;
    margin-inline: auto;
  }

  .hero-stage {
    position: relative;
    margin: 0.15rem auto 0;
    width: min(980px, 100%);
    min-height: 31rem;
    border: none;
    border-radius: 0;
    background: radial-gradient(circle at 80% 20%, rgba(171, 118, 72, 0.2), transparent 45%);
    overflow: hidden;
    padding: 0.2rem 0.6rem 0.7rem;
  }

  .hero-cta {
    position: absolute;
    left: 50%;
    bottom: 0.2rem;
    transform: translateX(-50%);
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
    justify-content: center;
    z-index: 5;
  }

  .hero-tags {
    position: absolute;
    left: 50%;
    bottom: 3.85rem;
    transform: translateX(-50%);
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
    z-index: 5;
  }

  .hero-tags span {
    padding: 0.32rem 0.64rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.76rem;
