---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Prince Ascel Jacne | Portfolio',
	description = 'Portfolio universel de Prince Ascel Jacne, developpeur full stack.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		padding: 0;
		min-height: 100%;
	}
</style>
