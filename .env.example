PORT=4000
FRONTEND_ORIGIN=http://localhost:4321

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-google-app-password-16-chars
SMTP_FROM=your-gmail@gmail.com

# Email qui recoit les messages du formulaire
CONTACT_RECEIVER=your-receiver@gmail.com

# Front URL for Astro form target (LOCAL uniquement)
# En production Vercel: laisser vide / non defini pour utiliser /api/contact
PUBLIC_CONTACT_API_BASE=http://localhost:4000
