# --- Envoi des emails du formulaire de contact ---
# En production : à renseigner dans Vercel > Settings > Environment Variables.
# En local : copier ce fichier en .env.

# Gmail SMTP (nécessite la validation en 2 étapes + un "mot de passe d'application")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-google-app-password-16-chars
# Optionnel : par défaut = SMTP_USER (avec Gmail, doit rester ton adresse Gmail)
SMTP_FROM=your-gmail@gmail.com

# Email qui reçoit les messages du formulaire (par défaut = SMTP_USER)
CONTACT_RECEIVER=your-receiver@gmail.com

# Optionnel : mettre false pour ne pas envoyer d'accusé de réception au visiteur
CONTACT_SEND_CONFIRMATION=true

# --- Développement local uniquement ---
PORT=4000
FRONTEND_ORIGIN=http://localhost:4321
# En production Vercel : ne pas définir, le formulaire utilise /api/contact
PUBLIC_CONTACT_API_BASE=http://localhost:4000
